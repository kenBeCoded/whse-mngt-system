#? update check out details on attendance_record

# update code:
#   0 - update status to pass
#   1 - update status to fail
#   2 - revert status to pending
#   3 - update schedule attendance records 

patch http://localhost:8000/api/attendance/audit-attendance-update
Content-Type: application/json
Authorization: Bearer {{AT}}

{
    "id": "54",
    "attendance_date": "2025-12-25",
    "update_code": 1
}

###
#? update schedule attendance records

patch http://localhost:8000/api/attendance/audit-attendance-update
Content-Type: application/json
Authorization: Bearer {{AT}}

{
    "id": 40,
    "attendance_date": "2025-10-13",
    "update_code": 3,
    "u_sched_in": "08:00",
    "u_sched_out": "16:00"
}

###
#? update single/multiple ot hours

patch http://localhost:8000/api/attendance/audit-attendance-update
Content-Type: application/json
Authorization: Bearer {{AT}}

{
    "idArr": [1, 2],
    "ot_hours": 3,
    "update_code": 4
}

