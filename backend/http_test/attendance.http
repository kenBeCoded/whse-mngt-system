# update code(create_attendance_records):
# 0 - Create a new attendance record
# 1 - Update check-in fields on existing record
# 2 - Update check-out fields on existing record
#? Create attendance_record and update check in details
post http://localhost:8000/api/attendance/create-attendance-record
Content-Type: application/json
Authorization: Bearer {{AT}}

{
    "username": "test1",
    "image_url": "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcR0n2dUPE7rmcyiWIArIrInNjSuHw5Wk9gJEw&s",
    "record_type": "check_in",
    "image_capture_date": "2025-10-17T12:34:33.205Z",
    "selected_date": "2025-10-17T12:34:33.205Z",
    "update_code": 0
}

